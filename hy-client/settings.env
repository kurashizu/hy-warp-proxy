# ===== hygw settings (KEY=VALUE, no spaces around '=') =====
# The proxy server. MUST be an IP address (the gateway never uses a DNS resolver).
SERVER_HOST=203.0.113.10
SERVER_PORT=443
AUTH_PASSWORD=CHANGE_ME
CERT_PIN=CHANGE_ME
SNI=home-n95

# FEC (UDPspeeder) against packet loss: 0 = off (direct QUIC on SERVER_PORT), 1 = on (uses FEC_PORT).
# FEC multiplies traffic up to ~2x. Available on linux-amd64, macOS, windows-amd64 only.
FEC=0
FEC_PORT=8443
SPEEDER_KEY=CHANGE_ME

# Where QEMU plugs in. Windows must use tcp. Linux/macOS may use unix:///path/to/hygw.sock
LISTEN=tcp://127.0.0.1:7777

# The VM's private network (must not collide with anything you care about; it is never routed on the host)
SUBNET=10.77.0.0/24
GATEWAY_IP=10.77.0.1
MTU=1400
DNS=1.1.1.1,1.0.0.1

# Exit check (through the tunnel): the VM has network only while Cloudflare WARP is proven on.
CHECK_INTERVAL=5
LOG_LEVEL=info
